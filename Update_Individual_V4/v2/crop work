                    # find the HIGHEST section_header above the figure that is
                    # aligned with it and not separated by another chart/table. Then
                    # extend the crop top to it -- the rectangle then includes any
                    # text elements between the header and the figure (handles
                    # <section_header><text><text><figure>).
                    _header_top = None
                    _header_lx = _header_rx = None
                    for he in raw_elems:
                        if str(he.get("type", "")).lower() not in _HEADER_TYPES:
                            continue
                        hb = he.get("bbox")
                        if not hb or not isinstance(hb[0], dict) or hb[0].get("page_id") != page_id:
                            continue
                        hc = hb[0].get("coord")
                        if not hc or len(hc) < 4:
                            continue
                        hx0, hy0, hx1, hy1 = hc
                        if hy1 > fy0 + 2:
                            continue                       # not above the chart
                        if _block_y is not None and hy1 <= _block_y:
                            continue                       # separated by another chart/table
                        _ov = min(hx1, fx1) - max(hx0, fx0)
                        if _ov < 0.25 * _fig_w:
                            continue                       # not aligned with the chart
                        # keep the HIGHEST (smallest y0) qualifying header
                        if _header_top is None or hy0 < _header_top:
                            _header_top = hy0; _header_lx = hx0; _header_rx = hx1
                    if _header_top is not None:
                        box["top"] = min(box["top"], _header_top)
                        box["left"] = min(box["left"], _header_lx)
                        box["right"] = max(box["right"], _header_rx)
                        # also widen to any TEXT element sitting between the header
                        # and the figure (so their left/right isn't clipped).
                        for te in raw_elems:
                            if str(te.get("type", "")).lower() not in ("text", "paragraph"):
                                continue
                            tb = te.get("bbox")
                            if not tb or not isinstance(tb[0], dict) or tb[0].get("page_id") != page_id:
                                continue
                            tc = tb[0].get("coord")
                            if not tc or len(tc) < 4:
                                continue
                            tx0, ty0, tx1, ty1 = tc
                            # the text must sit in the band between header top and figure
                            if ty0 >= _header_top and ty1 <= fy0 + 2:
                                _tov = min(tx1, fx1) - max(tx0, fx0)
                                if _tov >= 0.25 * _fig_w:
                                    box["left"] = min(box["left"], tx0)
                                    box["right"] = max(box["right"], tx1)


# new cropping
                if fig_idx is not None:
                    _MAX_WORDS = int(globals().get("_CROP_MAX_TEXT_WORDS", 200))

                    def _merge_box(e):
                        eb = e.get("bbox")
                        if not eb or not isinstance(eb[0], dict) or eb[0].get("page_id") != page_id:
                            return False
                        cc = eb[0].get("coord")
                        if not cc or len(cc) < 4:
                            return False
                        cx0, cy0, cx1, cy1 = cc
                        box["top"] = min(box["top"], cy0); box["bottom"] = max(box["bottom"], cy1)
                        box["left"] = min(box["left"], cx0); box["right"] = max(box["right"], cx1)
                        return True

                    # climb UP: include section_headers + SHORT text, until we hit a
                    # figure/table OR a long text block (>_MAX_WORDS). This captures
                    # the chart's title block (header + any short text between) while
                    # the figure/table boundary and the word cap prevent over-grabbing.
                    i = fig_idx - 1
                    while i >= 0:
                        e = raw_elems[i]
                        et = str(e.get("type", "")).lower()
                        if et in ("figure", "table"):
                            break                           # boundary -> stop
                        if et in _HEADER_TYPES:
                            _merge_box(e); i -= 1; continue   # header -> include, keep going
                        if et in ("text", "paragraph"):
                            _wc = len(str(e.get("content") or "").split())
                            if _wc > _MAX_WORDS:
                                break                       # big text block -> stop here
                            _merge_box(e); i -= 1; continue   # short text -> include
                        break                               # anything else -> stop

                    # climb DOWN: legend/footnote below the chart, stop at figure/table.
                    j = fig_idx + 1
                    while j < len(raw_elems):
                        e = raw_elems[j]
                        et = str(e.get("type", "")).lower()
                        if et in ("figure", "table"):
                            break
                        if et in _LEGEND_TYPES:
                            _merge_box(e); j += 1; continue
                        break
